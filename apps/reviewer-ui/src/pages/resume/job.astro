---
import ProgressSteps from "../../components/ProgressSteps.astro";
import Layout from "../../layouts/Layout.astro";
import { createProductJobJourney, existingProductTargets, inspectProductJobJourney, runProductJobJourney } from "../../../../../src/product-workflows.ts";
import { proofLayerUiRuntimeConfig } from "../../lib/runtime.js";
import { field, productActionToken, productPostRejection, productTokenMatches } from "../../lib/product.js";

const config = proofLayerUiRuntimeConfig();
const actionPath = "/resume/job";
const csrfToken = productActionToken(config, actionPath);
let error: string | undefined;
let targetId = Astro.url.searchParams.get("target") ?? undefined;

if (Astro.request.method === "POST") {
  const rejection = productPostRejection(Astro.request, config);
  if (rejection) return rejection;
  const formData = await Astro.request.formData();
  if (!productTokenMatches(formData, csrfToken)) return new Response("The Job form expired or failed local request verification.", { status: 403 });
  try {
    if (field(formData, "action") === "select") {
      targetId = field(formData, "targetId");
      if (!targetId) throw new Error("Choose an existing Job Target.");
      const result = await runProductJobJourney(config.workspace, targetId);
      return Astro.redirect(`/resume/job?target=${result.target.id}`, 303);
    }
    const pasted = field(formData, "description");
    const uploaded = formData.get("file");
    let description = pasted;
    if (!description && uploaded instanceof File && uploaded.size > 0) {
      if (uploaded.size > 2_000_000) throw new Error("Job Description must be 2 MB or smaller.");
      description = new TextDecoder("utf-8", { fatal: true }).decode(await uploaded.arrayBuffer());
    }
    if (!description) throw new Error("Paste or upload a Job Description.");
    const result = await createProductJobJourney(config.workspace, {
      description,
      title: field(formData, "title"),
      company: field(formData, "company"),
      location: field(formData, "location"),
      workingModel: field(formData, "workingModel"),
    });
    return Astro.redirect(`/resume/job?target=${result.target.id}`, 303);
  } catch (caught) {
    error = caught instanceof Error ? caught.message : "The Job Tailoring journey could not start safely.";
  }
}
const targets = await existingProductTargets(config.workspace);
let journey;
if (targetId) {
  try {
    journey = await inspectProductJobJourney(config.workspace, targetId);
  } catch {
    error ??= "That Job Target is not available or its current artifacts cannot be validated.";
  }
}
---

<Layout title="Tailor Resume to a Job" batchId={config.batchId} readOnly={config.readOnly}>
  <p class="eyebrow">Tailor to a Job</p><h1>Understand the job. Use only the proof you have.</h1>
  <p class="lede">Paste a Job Description, upload a text file, or continue an existing opportunity. ProofLayer keeps fit qualitative and never predicts whether you will be hired.</p>
  {error && <div class="notice error" role="alert">{error}</div>}

  {targets.jobs.length > 0 && <section class="panel existing-job-panel"><h2>Continue an existing opportunity</h2><form method="post" action={actionPath} class="inline-form"><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="action" value="select" /><label>Job Target <select name="targetId" required>{targets.jobs.map((target) => <option value={target.id} selected={target.id === targetId}>{target.title}{target.company ? ` — ${target.company}` : ""}</option>)}</select></label><button type="submit" disabled={config.readOnly}>Analyze and Tailor</button></form></section>}

  <details class="new-job-panel" open={targets.jobs.length === 0}><summary>Add a new Job Description</summary><form method="post" enctype="multipart/form-data" action={actionPath} class="product-form"><input type="hidden" name="csrfToken" value={csrfToken} /><input type="hidden" name="action" value="create" /><div class="form-grid"><label>Job title <input name="title" placeholder="Optional when front matter provides it" /></label><label>Company <input name="company" placeholder="ExampleCo" /></label><label>Location <input name="location" placeholder="Berlin, Germany" /></label><label>Working model <select name="workingModel"><option value="">Not specified</option><option value="remote">Remote</option><option value="hybrid">Hybrid</option><option value="onsite">On-site</option></select></label></div><p class="meta">Metadata is optional when the uploaded Markdown includes deterministic front matter.</p><label>Paste Job Description <textarea name="description" rows="12"></textarea></label><div class="form-divider"><span>or</span></div><label>Upload Markdown or text <input type="file" name="file" accept=".md,.markdown,.txt,text/plain,text/markdown" /></label><button type="submit" disabled={config.readOnly}>Analyze and Tailor</button></form></details>

  {journey && <>
    <section class="job-summary"><div><p class="eyebrow">Current opportunity</p><h2>{journey.target.title}</h2><p class="lede">{[journey.target.company, journey.target.location, journey.target.workingModel].filter(Boolean).join(" · ")}</p></div><div class={`fit-badge fit-${journey.fit.label.replace(" ", "-")}`}><small>Overall fit</small><strong>{journey.fit.label}</strong><span>Evidence-based, not hiring probability</span></div></section>
    <ProgressSteps steps={journey.progress} />
    <section class="fit-grid"><div class="panel"><p class="eyebrow">Mandatory requirements</p><h3>{journey.fit.mandatory.supported} supported <span class="meta">of {journey.fit.mandatory.total}</span></h3><p>{journey.fit.mandatory.partial} have partial support.</p></div><div class="panel"><p class="eyebrow">Preferred requirements</p><h3>{journey.fit.preferred.supported} supported <span class="meta">of {journey.fit.preferred.total}</span></h3><p>{journey.fit.preferred.partial} have partial support.</p></div></section>
    <div class="two-column"><section><h2>Strongest evidence-backed matches</h2>{journey.fit.strengths.length ? <ul class="readable-list">{journey.fit.strengths.map((value) => <li>{value}</li>)}</ul> : <div class="empty-state"><p>No direct strength is supported by the current eligible evidence.</p></div>}</section><section><h2>Material gaps</h2>{journey.fit.gaps.length ? <ul class="readable-list caution-list">{journey.fit.gaps.map((value) => <li>{value}</li>)}</ul> : <div class="empty-state"><p>No material gap is recorded in the current assessment.</p></div>}</section></div>
    {journey.fit.limitations.map((limitation) => <div class="notice">{limitation}</div>)}
    <section class="next-action-card"><p class="eyebrow">Smallest next action</p><h2>{journey.nextAction}</h2>{journey.advancedReviewBatchId && (journey.workflow.reviewGate?.pendingClaimCount ?? 0) > 0 && <a class="button secondary" href={`/review/${journey.advancedReviewBatchId}`}>Open Advanced Review</a>}</section>
    <details><summary>Advanced Details</summary><div class="status-table">{journey.workflow.stages.map((stage) => <div><span>{stage.label}</span><strong>{stage.status}</strong></div>)}</div><p class="audit">Target ID: <code>{journey.target.id}</code></p><p class="audit">No hiring probability, ATS score, or application recommendation is calculated.</p></details>
  </>}
</Layout>
