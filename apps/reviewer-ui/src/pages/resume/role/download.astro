---
import path from "node:path";
import { readFile } from "node:fs/promises";
import Layout from "../../../layouts/Layout.astro";
import { getRoleResumeExportStatus, listRoleResumeExports, showRoleResumeExport } from "../../../../../../src/role-resume-render-export.ts";
import { proofLayerUiRuntimeConfig } from "../../../lib/runtime.js";
import { showTarget } from "../../../../../../src/targets.ts";

const config = proofLayerUiRuntimeConfig();
const targetId = Astro.url.searchParams.get("target");
const exportId = Astro.url.searchParams.get("exportId");
if (exportId) {
  if (!targetId) return new Response("A Role Target is required for this download.", { status: 400 });
  const status = await getRoleResumeExportStatus(config.workspace, exportId);
  if (status.status !== "current" || !status.outputPath) {
    return new Response(`Resume export is not current: ${status.status}.`, { status: 409 });
  }
  const manifest = await showRoleResumeExport(config.workspace, exportId);
  if (manifest.targetId !== targetId) return new Response("Resume export belongs to a different Role Target.", { status: 403 });
  const root = path.resolve(config.workspace);
  const outputPath = path.resolve(root, manifest.outputPath);
  if (outputPath !== root && !outputPath.startsWith(`${root}${path.sep}`)) {
    return new Response("Resume export path is unsafe.", { status: 400 });
  }
  const body = await readFile(outputPath);
  const contentType = manifest.format === "html"
    ? "text/html; charset=utf-8"
    : manifest.format === "markdown"
      ? "text/markdown; charset=utf-8"
      : manifest.format === "pdf"
        ? "application/pdf"
        : "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
  const disposition = manifest.format === "html" ? "inline" : `attachment; filename="${path.basename(outputPath)}"`;
  return new Response(body, { headers: { "content-type": contentType, "content-disposition": disposition } });
}

let targetTitle: string | undefined;
let currentExports: Awaited<ReturnType<typeof listRoleResumeExports>> = [];
let error: string | undefined;
if (targetId) {
  try {
    const target = await showTarget(config.workspace, targetId);
    if (target.type !== "role") throw new Error("Resume downloads accept only Role Targets.");
    targetTitle = target.title;
    const manifests = await listRoleResumeExports(config.workspace, targetId);
    currentExports = (await Promise.all(manifests.map(async (manifest) => ({
      manifest,
      status: await getRoleResumeExportStatus(config.workspace, manifest.exportId),
    })))).filter(({ status }) => status.status === "current").map(({ manifest }) => manifest);
  } catch (caught) {
    error = caught instanceof Error ? caught.message : "Resume downloads could not be inspected safely.";
  }
}
---

<Layout title="Resume Export" batchId={config.batchId} readOnly={config.readOnly}>
  <p class="eyebrow">Resume downloads</p><h1>{targetTitle ? `${targetTitle} resume` : "Choose a current resume export"}</h1>
  {error && <div class="notice error" role="alert">{error}</div>}
  {!targetId && <div class="empty-state large"><p>Choose a Role Target from the Role Resume journey first.</p></div>}
  {targetId && !error && currentExports.length === 0 && <div class="empty-state large"><h2>No current downloads</h2><p>Prepare downloads from the approved Role Resume first.</p></div>}
  {currentExports.length > 0 && <section class="panel"><h2>Available formats</h2><div class="download-list">{currentExports.map((entry) => <a class="button secondary-action" href={`/resume/role/download?target=${encodeURIComponent(entry.targetId)}&exportId=${encodeURIComponent(entry.exportId)}`}>Download {entry.format.toUpperCase()}</a>)}</div></section>}
  <a class="button" href={`/resume/role${targetId ? `?target=${encodeURIComponent(targetId)}` : ""}`}>Back to Role Resume</a>
</Layout>

<style>.download-list { display: flex; flex-wrap: wrap; gap: .75rem; }</style>
