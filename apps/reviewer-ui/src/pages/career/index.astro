---
import Layout from "../../layouts/Layout.astro";
import { projectCareerTwin } from "../../../../../src/career-twin.ts";
import { proofLayerUiRuntimeConfig } from "../../lib/runtime.js";
import { formatProductDate } from "../../lib/product.js";

const config = proofLayerUiRuntimeConfig();
const twin = await projectCareerTwin(config.workspace);
const recentChanges = twin.latestRefresh
  ? Object.entries(twin.latestRefresh.changes)
      .map(([label, counts]) => ({
        label,
        count: counts.added + counts.changed + counts.removed,
      }))
      .filter(({ count }) => count > 0)
  : [];
---

<Layout title="My Career" batchId={config.batchId} readOnly={config.readOnly}>
  <section class="hero compact-hero">
    <div><p class="eyebrow">My Career</p><h1>Your Career Twin</h1><p class="lede">A persistent view of your professional history. Add to it over time; every resume remains a derived output.</p></div>
    <div class="hero-action"><span class={`pill ${twin.status.readyForOutputs ? "current" : "attention"}`}>{twin.status.trustLabel}</span><a class="button" href="/career/update">Update sources</a></div>
  </section>

  <section class="identity-card">
    <p class="eyebrow">Professional identity</p>
    <h2>{twin.identity.name}</h2>
    <p class="identity-headline">{twin.identity.headline}</p>
    <p>{twin.identity.summary}</p>
    <p class="meta">Last updated {formatProductDate(twin.status.lastUpdate)}</p>
  </section>

  <div class="career-layout">
    <section aria-labelledby="timeline-heading">
      <p class="eyebrow">Timeline</p><h2 id="timeline-heading">Roles and companies</h2>
      <div class="timeline">
        {twin.roles.length === 0
          ? <div class="empty-state"><p>No roles are organized yet.</p><a href="/career/update">Add a source to begin</a></div>
          : twin.roles.map((role) => (
              <article class="timeline-item"><span class="timeline-marker"></span><div><p class="meta">{role.dateRange ?? "Dates not recorded"}</p><h3>{role.title ?? "Role title needs confirmation"}</h3><p>{role.company ?? "Organization needs confirmation"}</p></div></article>
            ))}
      </div>
    </section>
    <aside>
      <section class="panel"><p class="eyebrow">Source coverage</p><h2>{twin.sources.length} source{twin.sources.length === 1 ? "" : "s"}</h2><p>{twin.status.sourceMessage}</p>{twin.sourceTypeCounts.map((source) => <p class="source-count"><span>{source.label}</span><strong>{source.count}</strong></p>)}</section>
      <section class="panel"><p class="eyebrow">Material questions</p><h2>{twin.questions.length}</h2><p>{twin.questions.length ? "Only unresolved questions that could affect an output are shown." : "ProofLayer has no current material clarification to ask."}</p>{twin.questions.length > 0 && <a href="/clarifications">Open Clarification Center</a>}</section>
    </aside>
  </div>

  <section aria-labelledby="projects-heading"><p class="eyebrow">Selected work</p><h2 id="projects-heading">Projects</h2><div class="project-grid">{twin.projects.map((project) => <article class="project-card"><h3>{project.name}</h3>{project.domains?.length && <p class="meta">{project.domains.join(" · ")}</p>}<div class="tag-list">{project.technologies?.map((technology) => <span>{technology}</span>)}</div></article>)}</div></section>

  <section aria-labelledby="capabilities-heading"><p class="eyebrow">Capabilities</p><h2 id="capabilities-heading">Skills and technologies</h2><div class="tag-cloud">{twin.skills.map((skill) => <span>{skill.name}</span>)}</div></section>

  <div class="two-column">
    <section><h2>Verified outcomes</h2>{twin.outcomes.length ? <ul class="readable-list">{twin.outcomes.map((outcome) => <li>{outcome}</li>)}</ul> : <div class="empty-state"><p>No reviewed achievement wording is currently projected here.</p><span>Existing final outputs remain available; unresolved evidence is not promoted.</span></div>}</section>
    <section><h2>Verified metrics</h2>{twin.verifiedMetrics.length ? <ul class="readable-list">{twin.verifiedMetrics.map((metric) => <li>{metric}</li>)}</ul> : <div class="empty-state"><p>No approved resume-ready metric is available.</p><span>ProofLayer will not infer or calculate one.</span></div>}</section>
  </div>

  <section class="panel" aria-labelledby="changes-heading">
    <p class="eyebrow">Recent changes</p>
    <h2 id="changes-heading">{twin.latestRefresh ? "Latest profile update" : "No refresh history yet"}</h2>
    {twin.latestRefresh
      ? recentChanges.length
        ? <div class="tag-list">{recentChanges.map((change) => <span>{change.count} {change.label} changed</span>)}</div>
        : <p>The latest refresh found no changes to your existing career knowledge.</p>
      : <p>Add a source when your experience changes. ProofLayer keeps the current Career Twin and does not ask you to start over.</p>}
  </section>

  <details><summary>View source details and advanced audit state</summary><div class="evidence-grid">{twin.sources.map((source) => <article class="evidence-item"><h3>{source.label}</h3><p>{source.type.replaceAll("_", " ")} · {source.status} · {source.visibility}</p><p class="audit">Source ID: <code>{source.id}</code></p></article>)}</div></details>
</Layout>
