---
import ReviewForm from "../../../../components/ReviewForm.astro";
import RecommendationAction from "../../../../components/RecommendationAction.astro";
import SimpleReviewForm from "../../../../components/SimpleReviewForm.astro";
import Layout from "../../../../layouts/Layout.astro";
import {
  proofLayerUiRuntimeConfig,
  formRecord,
  isSameOriginSubmission,
} from "../../../../lib/runtime.js";
import {
  EvidenceReviewUiSubmissionError,
  loadEvidenceReviewUiClaim,
  submitEvidenceReviewUiClaim,
} from "../../../../../../../src/evidence-review-ui.ts";
import {
  evidenceReviewUiClaimCsrfToken,
  evidenceReviewUiCsrfTokenMatches,
} from "../../../../../../../src/evidence-review-ui-csrf.ts";
import {
  deriveEvidenceReviewRecommendation,
} from "../../../../../../../src/evidence-review-recommendation.ts";

const config = proofLayerUiRuntimeConfig();
const batchId = Astro.params.batchId;
const claimId = Astro.params.claimId;
if (!batchId || (config.mode === "review" && batchId !== config.batchId) || !claimId || !/^claim_[A-Za-z0-9_-]+$/.test(claimId)) {
  return new Response("Review claim not found.", { status: 404 });
}
const csrfToken = evidenceReviewUiClaimCsrfToken(config.csrfSecret, batchId, claimId);

let values: Record<string, string | undefined> = {};
let fieldErrors: Record<string, string[]> = {};
let submissionError: string | undefined;

if (Astro.request.method === "POST") {
  if (config.readOnly) {
    return new Response("Review submissions are disabled in read-only mode.", {
      status: 405,
      headers: { Allow: "GET" },
    });
  }
  if (!isSameOriginSubmission(Astro.request, config.origin)) {
    return new Response("The review submission origin is not allowed.", { status: 403 });
  }
  const formData = await Astro.request.formData();
  values = formRecord(formData);
  if (!evidenceReviewUiCsrfTokenMatches(values.csrfToken, csrfToken)) {
    submissionError = "The review form expired or failed local request verification. Reload and try again.";
  } else {
    try {
      const submission = await submitEvidenceReviewUiClaim(
        config.workspace,
        batchId,
        claimId,
        values,
      );
      const destination = values.submitAction === "batch"
        ? `/review/${batchId}`
        : submission.batchComplete
          ? `/review/${batchId}/complete`
          : submission.nextPendingClaimId
            ? `/review/${batchId}/claim/${submission.nextPendingClaimId}`
            : `/review/${batchId}`;
      const query = new URLSearchParams({
        result: submission.result.result,
        review: submission.result.reviewId,
      });
      return Astro.redirect(`${destination}?${query.toString()}`, 303);
    } catch (error) {
      if (error instanceof EvidenceReviewUiSubmissionError) {
        submissionError = error.message;
        fieldErrors = error.fieldErrors;
      } else {
        submissionError = "The review could not be submitted safely. No canonical review was written.";
      }
    }
  }
}

let loaded;
try {
  loaded = await loadEvidenceReviewUiClaim(config.workspace, batchId, claimId);
} catch {
  return new Response("Review claim not found.", { status: 404 });
}
const { batch, claim } = loaded;
const sourceCategories = [...new Set(claim.evidence.map((entry) => entry.category))];
const claimIndex = batch.claims.findIndex((entry) => entry.id === claim.id);
const previousClaim = claimIndex > 0 ? batch.claims[claimIndex - 1] : undefined;
const nextClaim = claimIndex >= 0 && claimIndex < batch.claims.length - 1
  ? batch.claims[claimIndex + 1]
  : undefined;
const nextPendingClaim = batch.claims.find((entry) =>
  entry.id !== claim.id && entry.review.lifecycle !== "current");
const result = Astro.url.searchParams.get("result");
const resultReviewId = Astro.url.searchParams.get("review");
const revising = claim.review.lifecycle === "current" && (
  Astro.url.searchParams.get("revise") === "true" || values.confirmSupersession === "true"
);
const recommendation = deriveEvidenceReviewRecommendation(claim);
const recommendationFailed = Boolean(
  submissionError && values.reviewMode === "recommendation",
);
const requiresManualReview = revising ||
  recommendation.interactionLevel === "manual" ||
  recommendationFailed;
---

<Layout title={claim.title} batchId={batch.batchId} readOnly={config.readOnly}>
  <nav class="claim-navigation" aria-label="Claim review navigation">
    <a href={`/review/${batch.batchId}`}>Back to batch</a>
    <span>Claim {claimIndex + 1} of {batch.claims.length}</span>
    <span>{batch.progress.reviewed} reviewed · {batch.progress.pending} pending</span>
    {nextPendingClaim && (
      <a href={`/review/${batch.batchId}/claim/${nextPendingClaim.id}`}>Next pending: {nextPendingClaim.title}</a>
    )}
    <span class="navigation-links">
      {previousClaim
        ? <a href={`/review/${batch.batchId}/claim/${previousClaim.id}`}>Previous</a>
        : <span aria-disabled="true">Previous</span>}
      {nextClaim
        ? <a href={`/review/${batch.batchId}/claim/${nextClaim.id}`}>Next</a>
        : <span aria-disabled="true">Next</span>}
    </span>
  </nav>

  {result && (
    <div class="notice success" role="status">
      <strong>Review saved.</strong>
      <p>{result === "already-current" ? "The identical immutable review was already current." : "The canonical review was created successfully."}</p>
      {resultReviewId && <p class="meta">Review reference: <code>{resultReviewId}</code></p>}
    </div>
  )}

  <p class="eyebrow">{claim.priority} priority claim</p>
  <h1>{claim.title}</h1>
  <p class="lede">{claim.selectionReason}</p>

  <section aria-labelledby="claim-heading">
    <h2 id="claim-heading">Claim being reviewed</h2>
    <div class="excerpt">{claim.text}</div>
  </section>

  <div class="claim-details">
    <details>
      <summary>View evidence</summary>
      <section aria-labelledby="evidence-heading">
        <h2 id="evidence-heading">Supporting evidence</h2>
        <div class="evidence-grid">
          {claim.evidence.map((evidence, index) => (
            <article class="evidence-item">
              <h3>Evidence {index + 1}: {evidence.title}</h3>
              <p>{evidence.summary}</p>
              <p class="meta">
                {[evidence.category, evidence.confidence, evidence.visibility, evidence.company, evidence.project]
                  .filter(Boolean).join(" · ")}
              </p>
              {evidence.technologies.length > 0 && <p><strong>Technologies:</strong> {evidence.technologies.join(", ")}</p>}
              {evidence.domains.length > 0 && <p><strong>Domains:</strong> {evidence.domains.join(", ")}</p>}
            </article>
          ))}
        </div>
      </section>
    </details>

    <details>
      <summary>View source excerpt</summary>
      <section aria-labelledby="source-excerpt-heading">
        <h2 id="source-excerpt-heading">Exact source excerpt</h2>
        {claim.evidence.map((evidence, index) => (
          <article class="evidence-item">
            <h3>Evidence {index + 1}: {evidence.title}</h3>
            {evidence.sourceExcerpt
              ? <div class="excerpt">{evidence.sourceExcerpt}</div>
              : <p class="notice">Exact source excerpt withheld by evidence visibility policy. The safe normalized summary remains available under View evidence.</p>}
          </article>
        ))}
      </section>
    </details>

    <details>
      <summary>View matched requirements</summary>
      <section aria-labelledby="requirements-heading">
        <h2 id="requirements-heading">Matching Job requirements</h2>
        {claim.requirements.length === 0
          ? <p>No matching Job Requirement references were recorded by this batch.</p>
          : <div class="evidence-grid">
              {claim.requirements.map((requirement, index) => (
                <article class="evidence-item">
                  <h3>Requirement {index + 1}: {requirement.title}</h3>
                  <div class="excerpt">{requirement.sourceText}</div>
                  <p class="meta">
                    {requirement.category} · {requirement.necessity} · {requirement.confidence} · {requirement.explicitness}
                  </p>
                </article>
              ))}
            </div>}
      </section>
    </details>

    <details>
      <summary>View limitations and current state</summary>
      <section aria-labelledby="limitations-heading">
        <h2 id="limitations-heading">Evidence limitations and boundaries</h2>
        <ul>
          <li>Priority and matching terms organize human review; they do not prove this claim satisfies a requirement.</li>
          <li>Source approval is <strong>{claim.sourceApprovalStatus}</strong>; source output readiness is <strong>{claim.sourceOutputReadiness}</strong>.</li>
          <li>Evidence categories: {sourceCategories.join(", ") || "not classified"}.</li>
          <li>Project evidence cannot become employment history without explicit role provenance.</li>
          <li>Responsibility cannot become achievement without supported outcome proof.</li>
        </ul>
      </section>

      <section aria-labelledby="state-heading">
        <h2 id="state-heading">Current classification and eligibility</h2>
        <div class="summary-grid">
          <div class="stat"><strong>{claim.review.lifecycle}</strong> Review lifecycle</div>
          <div class="stat"><strong>{claim.review.decision ?? "not decided"}</strong> Decision</div>
          <div class="stat"><strong>{claim.review.publicSafety ?? (claim.sourcePublicSafe ? "source public-safe" : "not reviewed")}</strong> Public safety</div>
          <div class="stat"><strong>{claim.review.resumeReadiness ?? claim.sourceOutputReadiness}</strong> Resume readiness</div>
          <div class="stat"><strong>{claim.review.eligibleForRoleMatching === undefined ? "not decided" : claim.review.eligibleForRoleMatching ? "yes" : "no"}</strong> Role Matching</div>
          <div class="stat"><strong>{claim.review.eligibleForJobMapping === undefined ? "not decided" : claim.review.eligibleForJobMapping ? "yes" : "no"}</strong> Job Mapping</div>
        </div>
        {claim.review.id && (
          <p class="meta">
            Current immutable review reference: <code>{claim.review.id}</code>. Private reviewer rationale is not displayed.
          </p>
        )}
      </section>
    </details>
  </div>

  <section aria-labelledby="review-heading">
    <h2 id="review-heading">Review decision</h2>
    {submissionError && (
      <div class="notice error" role="alert" tabindex="-1" autofocus>
        <strong>Review not submitted.</strong>
        <p>{submissionError}</p>
        {Object.values(fieldErrors).flat().length > 0 && (
          <ul>{Object.values(fieldErrors).flat().map((error) => <li>{error}</li>)}</ul>
        )}
      </div>
    )}
    {config.readOnly
      ? <div class="notice">Submission is disabled in read-only mode. No POST action is available.</div>
      : claim.review.lifecycle === "current" && !revising
        ? <div class="panel current-review-summary">
            <h3>Current immutable review</h3>
            <p>
              Decision: <strong>{claim.review.decision}</strong> · Public safety: <strong>{claim.review.publicSafety}</strong> ·
              Resume readiness: <strong>{claim.review.resumeReadiness}</strong>
            </p>
            {claim.review.requiredQualifiers.length > 0 && (
              <p><strong>Required qualifiers:</strong> {claim.review.requiredQualifiers.join("; ")}</p>
            )}
            <p class="meta">The existing review remains read-only. A changed decision creates a new immutable version linked by supersession.</p>
            <a class="button secondary" href={`/review/${batch.batchId}/claim/${claim.id}?revise=true#review-heading`}>
              Create revised review
            </a>
          </div>
        : <>
            {revising && (
              <div class="notice">
                A new submission will explicitly supersede review <code>{claim.review.id}</code>. The prior review remains immutable.
              </div>
            )}
            {!recommendationFailed && (
              <RecommendationAction
                batchId={batch.batchId}
                claim={claim}
                csrfToken={csrfToken}
                recommendation={recommendation}
              />
            )}
            {recommendationFailed && (
              <div class="notice">
                The one-click projection did not pass authoritative validation. No review was written; use the manual controls below.
              </div>
            )}
            {requiresManualReview
              ? <>
                  <SimpleReviewForm
                    batchId={batch.batchId}
                    claim={claim}
                    csrfToken={csrfToken}
                    values={values}
                    fieldErrors={fieldErrors}
                    superseding={revising}
                  />
                  <details class="advanced-review" open={values.reviewMode === "advanced"}>
                    <summary>Advanced Review</summary>
                    <div class="notice">
                      Exceptional or ambiguous cases only. This form exposes the full canonical review schema and uses the same authoritative validation and immutable service.
                    </div>
                    <ReviewForm
                      batchId={batch.batchId}
                      claim={claim}
                      csrfToken={csrfToken}
                      values={values}
                      fieldErrors={fieldErrors}
                      superseding={revising}
                    />
                  </details>
                </>
              : <details
                  class="change-decision"
                  open={values.reviewMode === "simple" || values.reviewMode === "advanced"}
                >
                  <summary>Change decision</summary>
                  <SimpleReviewForm
                    batchId={batch.batchId}
                    claim={claim}
                    csrfToken={csrfToken}
                    values={values}
                    fieldErrors={fieldErrors}
                    superseding={revising}
                    overrideOnly
                  />
                  <details class="advanced-review" open={values.reviewMode === "advanced"}>
                    <summary>Advanced Review</summary>
                    <div class="notice">
                      Exceptional or ambiguous cases only. This form exposes the full canonical review schema and uses the same authoritative validation and immutable service.
                    </div>
                    <ReviewForm
                      batchId={batch.batchId}
                      claim={claim}
                      csrfToken={csrfToken}
                      values={values}
                      fieldErrors={fieldErrors}
                      superseding={revising}
                    />
                  </details>
                </details>}
          </>}
  </section>

  <details>
    <summary>Internal references and provenance</summary>
    <div class="audit">
      <p>Claim ID: <code>{claim.id}</code></p>
      <p>Batch ID: <code>{claim.audit.batchId}</code></p>
      <p>Target ID: <code>{claim.audit.targetId}</code></p>
      <p>Claim record SHA-256: <code>{claim.audit.claimRecordSha256}</code></p>
      <p>Evidence set SHA-256: <code>{claim.audit.evidenceSetSha256}</code></p>
      <p>Provenance set SHA-256: <code>{claim.audit.provenanceSetSha256}</code></p>
      <p>Requirement set SHA-256: <code>{claim.audit.requirementSetSha256}</code></p>
      <p>Canonical review template: <code>{claim.template.path}</code></p>
      {claim.evidence.map((evidence) => (
        <section>
          <h3>{evidence.title}</h3>
          <p>Evidence ID: <code>{evidence.id}</code></p>
          {evidence.sources.map((source) => (
            <p>
              Source: {source.label} · ID <code>{source.id}</code> · SHA-256 <code>{source.sha256}</code>
            </p>
          ))}
        </section>
      ))}
      {claim.requirements.map((requirement) => (
        <section>
          <h3>{requirement.title}</h3>
          <p>Requirement ID: <code>{requirement.id}</code></p>
          {requirement.sourceReferences.map((reference) => (
            <p>
              {reference.label}, lines {reference.startLine}-{reference.endLine};
              source SHA-256 <code>{reference.sha256}</code>;
              excerpt SHA-256 <code>{reference.excerptSha256}</code>
            </p>
          ))}
        </section>
      ))}
    </div>
  </details>
</Layout>
