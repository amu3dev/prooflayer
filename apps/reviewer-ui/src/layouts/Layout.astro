---
import "../styles/global.css";

interface Props {
  title: string;
  batchId?: string;
  readOnly: boolean;
}

const { title, batchId, readOnly } = Astro.props;
const path = Astro.url.pathname;
const navigation = [
  { href: "/", label: "Home", active: path === "/" },
  { href: "/career", label: "My Career", active: path.startsWith("/career") && path !== "/career/update" },
  { href: "/resume/role", label: "Create Resume", active: path.startsWith("/resume/role") },
  { href: "/resume/job", label: "Tailor to a Job", active: path.startsWith("/resume/job") },
  { href: "/career/update", label: "Updates", active: path === "/career/update" },
  { href: batchId ? `/review/${batchId}` : "/advanced-review", label: "Advanced Review", active: path.startsWith("/review") || path === "/advanced-review" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'" />
    <title>{title} | ProofLayer</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href="/" aria-label="ProofLayer home">
          <span class="brand-mark" aria-hidden="true">P</span>
          <span>ProofLayer</span>
        </a>
        <span class="mode">{readOnly ? "Read-only" : "Local-first"}</span>
      </div>
      <nav class="shell global-nav" aria-label="Main navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <div class="shell">
        <slot />
      </div>
    </main>
  </body>
</html>
